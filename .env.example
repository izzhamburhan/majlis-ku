# Copy to .env and fill in. Never commit .env.
# Phase 1 needs the "App", "Database" and "Auth" sections. Later sections become required in the phase noted.

# --- App ---
# Public base URL, used in QR codes, share links and Open Graph tags
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Salt for hashing device tokens and rate-limit keys (any long random string)
HASH_SALT=change-me

# --- Database ---
# Local: npm run db:start (embedded PostgreSQL on port 5433, so it does not clash with an installed PostgreSQL on 5432). With your own PostgreSQL, point DATABASE_URL at it and skip db:start.
DATABASE_URL=postgresql://majlis:majlis@localhost:5433/majlis?schema=public

# --- Auth (Auth.js) ---
# Generate with: npx auth secret
AUTH_SECRET=
AUTH_URL=http://localhost:3000
# Google OAuth client (console.cloud.google.com > Credentials)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Magic-link email. Leave EMAIL_SERVER empty in development to print the link to the server log.
EMAIL_SERVER=
EMAIL_FROM="Majlis Ku <no-reply@majlisku.test>"
# Comma-separated admin emails: promoted to admin on sign-in, and checked on every request (removing one revokes access)
ADMIN_EMAILS=admin@majlisku.test

# --- Media storage ---
# local = files on this computer under LOCAL_MEDIA_DIR (default); s3 = any S3-compatible store (Supabase Storage, Cloudflare R2, AWS S3)
STORAGE_DRIVER=local
LOCAL_MEDIA_DIR=.data/media
# S3-compatible settings. All five are required when STORAGE_DRIVER=s3; the app names any that is missing.
# Supabase Storage (private bucket):
#   S3_ENDPOINT  https://<project-ref>.storage.supabase.co/storage/v1/s3
#   S3_REGION    the region shown under Storage > S3 connection in the Supabase dashboard (for example ap-southeast-1)
#   S3_ACCESS_KEY_ID and S3_SECRET_ACCESS_KEY  create an access key on the same S3 connection page; keep it secret
# Cloudflare R2: S3_ENDPOINT https://<account-id>.r2.cloudflarestorage.com, S3_REGION auto.
# AWS S3: S3_ENDPOINT https://s3.<region>.amazonaws.com, S3_REGION the bucket's region.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional: largest single file in bytes, applied below the plan cap (for example 52428800 on the Supabase free plan, which stops files above 50 MB). Larger files are refused before upload.
S3_MAX_OBJECT_BYTES=
# Tests only (not read by the app): set all five to run the shared driver suite against a throwaway bucket; skipped otherwise.
# S3_TEST_ENDPOINT=
# S3_TEST_REGION=
# S3_TEST_BUCKET=
# S3_TEST_ACCESS_KEY_ID=
# S3_TEST_SECRET_ACCESS_KEY=
# Public CDN base for thumbnails and display copies, if served through a CDN
MEDIA_CDN_URL=

# --- Payments (phase 6) ---
# Which PaymentProvider adapter to use: billplz | toyyibpay | stripe
PAYMENT_PROVIDER=
# true = gateway sandbox
PAYMENT_SANDBOX=true
PAYMENT_API_KEY=
# Secret used to verify webhook signatures
PAYMENT_WEBHOOK_SECRET=
# Gateway-specific id (Billplz collection id, ToyyibPay category code)
PAYMENT_COLLECTION_ID=

# --- Jobs (phase 8) ---
# 16 or more characters. Enables POST /api/cron/purge (header "Authorization: Bearer <secret>") for an external scheduler; unset = the route returns 404.
# The hourly in-process purge of expired events runs without it.
CRON_SECRET=